# Root environment — used by docker-compose and Render blueprint.
# This file is a template for the *user* of the generated MVP; copy to .env
# and fill values. Every variable has a placeholder default.

APP_NAME=__APP_NAME__
APP_TITLE=__APP_TITLE__
APP_ENV=production
JWT_SECRET=__JWT_SECRET__
PORT=3000

# Composite local DATABASE_URL (overridden by Render's database service)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app_db

# Optional frontend customization (leave empty to use unified relative /api/v1 routing)
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_APP_NAME=__APP_TITLE__