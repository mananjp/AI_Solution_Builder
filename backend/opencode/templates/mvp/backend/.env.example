# Backend configuration — copy to .env and fill in real values.
APP_NAME=__APP_NAME__
APP_TITLE=__APP_TITLE__
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# PostgreSQL (asyncpg). On Render this is provided as DATABASE_URL.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app_db

# Security — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=__JWT_SECRET__
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

BACKEND_PORT=8000
LOG_LEVEL=info

# External integrations (leave blank if unused)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=