{
  "$schema": "https://opencode.ai/config.json",
  "model": "{env:OPENCODE_MODEL:-groq/openai/gpt-oss-120b}",
  "provider": {
    "groq": {
      "apiKey": "{env:GROQ_API_KEY}"
    }
  },
  "agent": {
