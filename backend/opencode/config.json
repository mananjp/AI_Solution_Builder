{
  "$schema": "https://opencode.ai/config.json",
  "model": "__OPENCODE_MODEL__",
  "small_model": "__OPENCODE_SMALL_MODEL__",
  "provider": {
    "groq": {
      "options": {
        "apiKey": "{env:GROQ_API_KEY}"
      }
    }
  },
  "agent": {
    "mvp-builder": {
      "description": "Builds full-stack functional MVP prototypes (Next.js + FastAPI) from AI Solution Builder artifacts",
      "mode": "primary",
      "model": "__OPENCODE_MODEL__"
    }
  }
}
