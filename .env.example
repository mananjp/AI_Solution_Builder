# AI Solution Builder — Environment Configuration
# Copy this file to .env and fill in your values

# ── Database ──────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_solution_builder

# ── AI / Groq ─────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key_here
# Pin the exact generation model. Changing this in production can shift cost/latency/output quality.
GROQ_MODEL_NAME=openai/gpt-oss-120b

# ── JWT Auth ──────────────────────────────────────
# REQUIRED in production: the app refuses to boot when APP_ENV=production unless this is
# a unique secret >= 32 chars (never the placeholder below, never "change-me").
JWT_SECRET_KEY=change-this-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── App ───────────────────────────────────────────
APP_NAME=AI Solution Builder
APP_ENV=development
CORS_ORIGINS=http://localhost:3000

# ── Embeddings ────────────────────────────────────
# Uses local sentence-transformers model (no API key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── OpenCode MVP Builder Sidecar ─────────────────
# URL of the opencode serve sidecar. Use http://opencode:4096 when running
# the backend in Docker (docker-compose), or http://localhost:4096 for local dev.
OPENCODE_SERVER_URL=http://localhost:4096
# Optional basic-auth password; must match OPENCODE_SERVER_PASSWORD in the
# opencode service if configured.
OPENCODE_SERVER_PASSWORD=
# Model used by the sidecar for code generation (opencode/big-pickle is free on OpenCode Zen).
OPENCODE_MODEL=opencode/big-pickle
# Timeout (seconds) for a single MVP build request.
MVP_BUILD_TIMEOUT=600
# Local directory that mirrors the sidecar's shared /workspace volume.
MVP_BUILD_DIR=.data/mvp_builds
# Credits deducted per MVP build.
MVP_BUILD_CREDIT_COST=30

# ── Object Storage (Cloudinary) ──────────────────
# Omit all CLOUDINARY_* vars to keep local disk storage (default).
# Set STORAGE_BACKEND=cloudinary and fill in the credentials to enable Cloudinary uploads.
# STORAGE_BACKEND=local
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
