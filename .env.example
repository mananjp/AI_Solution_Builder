# AI Solution Builder — Environment Configuration
# Copy this file to .env and fill in your values

# ── Database (PostgreSQL + pgvector) ──────────────
# Local Docker Compose:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_solution_builder
# Serverless Neon DB (pgvector built-in, raw URLs with ?sslmode=require normalized automatically):
# DATABASE_URL=postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── Redis (Cache, Rate Limiting & Queue) ──────────
# Local Docker Compose:
REDIS_URL=redis://localhost:6379/0
# Serverless Upstash Redis (TLS rediss:// connection):
# REDIS_URL=rediss://default:password@us1-xyz.upstash.io:6379

# ── AI / Groq ─────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key_here
# Pin the exact generation model. Changing this in production can shift cost/latency/output quality.
GROQ_MODEL_NAME=openai/gpt-oss-120b

# ── JWT Auth ──────────────────────────────────────
# REQUIRED in production: the app refuses to boot when APP_ENV=production unless this is
# a unique secret >= 32 chars (never the placeholder below, never "change-me").
JWT_SECRET_KEY=change-this-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── App ───────────────────────────────────────────
APP_NAME=AI Solution Builder
APP_ENV=development
CORS_ORIGINS=http://localhost:3000

# ── Embeddings ────────────────────────────────────
# Uses local sentence-transformers model (no API key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── OpenCode MVP Builder Sidecar ─────────────────
# URL of the opencode serve sidecar. Use http://opencode:4096 when running
# the backend in Docker (docker-compose), or http://localhost:4096 for local dev.
OPENCODE_SERVER_URL=http://localhost:4096
# Optional basic-auth password; must match OPENCODE_SERVER_PASSWORD in the
# opencode service if configured.
OPENCODE_SERVER_PASSWORD=
# Model used by the sidecar for code generation (Groq-direct, bills your GROQ_API_KEY).
OPENCODE_MODEL=groq/openai/gpt-oss-120b
# Timeout (seconds) for a single MVP build request.
MVP_BUILD_TIMEOUT=600
# Local directory that mirrors the sidecar's shared /workspace volume.
MVP_BUILD_DIR=.data/mvp_builds
# Credits deducted per MVP build.
MVP_BUILD_CREDIT_COST=30
# Timeout (seconds) for npm install during verification checkpoint.
MVP_VERIFY_INSTALL_TIMEOUT=180
# Timeout (seconds) for npm run build during verification checkpoint.
MVP_VERIFY_BUILD_TIMEOUT=120

# ── Object Storage (Cloudinary) ──────────────────
# Omit all CLOUDINARY_* vars to keep local disk storage (default).
# Set STORAGE_BACKEND=cloudinary and fill in the credentials to enable Cloudinary uploads.
# STORAGE_BACKEND=local
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ── Worker & Queue Architecture ──────────────────
# WORKER_MODE=inline (default in code) executes builds synchronously within the
# API process — required for the one-click premade-app path to run immediately.
# Set WORKER_MODE=worker to run builds through the background worker service/container.
WORKER_MODE=inline
# Interval in seconds between worker queue polling cycles.
WORKER_POLL_INTERVAL=2.0

# ── Frontend & Redirects ──────────────────────────
# Base URL of the frontend application for OAuth redirects and CORS validation.
FRONTEND_URL=http://localhost:3000

# ── OAuth Social Login ───────────────────────────
# Omit or leave empty to disable that social login provider.
# Buttons are dynamically shown on the login/register page only when BOTH ID and secret are set.
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=

# ── Anonymous Demo Identity ──────────────────────
# Enables one-click guest access with sandbox credits for instant product evaluation.
ALLOW_ANONYMOUS_AUTH=true
# Credits pre-funded to guest accounts on creation (allows exploring solutions and builds).
ANONYMOUS_CREDITS=50

# ── Low Memory Tuning (512MB Free Tier Containers) ─
# Glibc memory arena cap (prevents RSS heap bloat in multi-threaded Python):
MALLOC_ARENA_MAX=2
# Node.js heap limit for Next.js & OpenCode (triggers early GC, keeps RSS under 110MB):
NODE_OPTIONS=--max-old-space-size=110
# PostgreSQL connection pool limits:
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_RECYCLE=300
# Toggle OpenCode sidecar if you want minimum possible RAM footprint (<180MB total):
ENABLE_OPENCODE_SIDECAR=true
