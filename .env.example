# AI Solution Builder — Environment Configuration
# Copy this file to .env and fill in your values

# ── Database (PostgreSQL + pgvector) ──────────────
# Local Docker Compose:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/ai_solution_builder
# Serverless Neon DB (pgvector built-in, raw URLs with ?sslmode=require normalized automatically):
# DATABASE_URL=postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── Redis (Cache, Rate Limiting & Queue) ──────────
# Local Docker Compose:
REDIS_URL=redis://localhost:6379/0
# Serverless Upstash Redis (TLS rediss:// connection):
# REDIS_URL=rediss://default:password@us1-xyz.upstash.io:6379

# ── AI / Groq ─────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key_here
# Pin the exact generation model. Changing this in production can shift cost/latency/output quality.
GROQ_MODEL_NAME=openai/gpt-oss-120b

# ── Product Image Generation (Gemini) ─────────────
# Optional. When GEMINI_API_KEY is empty the build's "illustrating" phase is
# skipped entirely and the build proceeds to verification unchanged — image
# generation can never block or fail a build.
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Image-capable model. gemini-2.5-flash-image is the current fast/cheap option;
# gemini-3-pro-image-preview is higher fidelity but slower and costlier.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Master kill-switch. Set false to disable image generation without removing the key.
IMAGE_GENERATION_ENABLED=true
# How many visuals to attempt per build (hero, UI mockup, app icon).
MVP_IMAGE_COUNT=3
# Per-image request timeout in seconds.
MVP_IMAGE_TIMEOUT=120
# Cap on the whole illustration phase. Checked before each new image, so an
# overrun still keeps whatever already finished instead of discarding it.
MVP_IMAGE_TOTAL_BUDGET=180

# ── Auth0 Identity ─────────────────────────────────
# The browser values are public identifiers; set them as NEXT_PUBLIC_* in the
# frontend build environment. The backend validates RS256 API access tokens.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.example.com
AUTH0_ENABLED=true
AUTH0_ROLE_CLAIM=https://sutra.app/roles
AUTH0_ADMIN_EMAILS=
DEV_AUTH_BYPASS=false
# Set these in frontend/.env.local for local development and in the frontend
# build environment for production (Vercel or Docker).
NEXT_PUBLIC_AUTH0_DOMAIN=your-tenant.us.auth0.com
NEXT_PUBLIC_AUTH0_CLIENT_ID=your-spa-client-id
NEXT_PUBLIC_AUTH0_AUDIENCE=https://api.example.com
# Optional; defaults to https://<frontend-origin>/callback.
# NEXT_PUBLIC_AUTH0_CALLBACK_URL=https://app.example.com/callback

# Separate high-entropy key for encrypted GitHub/Render/Vercel credentials.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_ENCRYPTION_KEY=replace-with-a-unique-random-secret
FRONTEND_URL=http://localhost:3000

# ── App ───────────────────────────────────────────
APP_NAME=AI Solution Builder
APP_ENV=development
CORS_ORIGINS=http://localhost:3000

# ── Embeddings ────────────────────────────────────
# Uses local sentence-transformers model (no API key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── OpenCode MVP Builder Sidecar ─────────────────
# URL of the opencode serve sidecar. Use http://opencode:4096 when running
# the backend in Docker (docker-compose), or http://localhost:4096 for local dev.
OPENCODE_SERVER_URL=http://localhost:4096
OPENCODE_SERVER_USERNAME=opencode
# If set, must match the password protecting `opencode serve` on this service.
OPENCODE_SERVER_PASSWORD=
# PARALLEL BUILDS — comma-separated URL pool (one sidecar container per user/session).
# With `docker compose up --scale opencode=3` replicas answer as opencode-1/2/3:
#   OPENCODE_POOL_URLS=http://opencode-1:4096,http://opencode-2:4096,http://opencode-3:4096
# Sessions are hashed deterministically onto one pool member, so they stick to it.
OPENCODE_POOL_URLS=
# Optional: OpenCode Zen API key — required for the opencode/* Zen models.
# The default models below (opencode/step-5-preview-free and
# opencode/nemotron-3.5-lightning-free) are free and use this key; leave it empty
# and set OPENCODE_MODEL to a groq/* model to use your GROQ_API_KEY instead.
# Get one from https://opencode.ai/zen.
OPENCODE_ZEN_API_KEY=
# Model used by the sidecar for code generation. Both defaults are FREE.
#   opencode/step-5-preview-free      (default; strong coding, 0 cost via OpenCode Zen)
#   opencode/nemotron-3.5-lightning-free (cheap/free; recommended small_model)
#   groq/openai/gpt-oss-120b          (uses GROQ_API_KEY — no extra key)
OPENCODE_MODEL=opencode/step-5-preview-free
# Cheap model for titles/summaries and other short calls — frees the primary
# model's quota for actual code generation. Must be a cheaper model than OPENCODE_MODEL.
OPENCODE_SMALL_MODEL=opencode/nemotron-3.5-lightning-free
# Agent (profile) the sidecar uses for MVP generation.
OPENCODE_AGENT=mvp-builder
# Only used by local Docker Compose. Override when your network requires
# corporate/internal resolvers; production platforms manage DNS themselves.
OPENCODE_DNS_PRIMARY=1.1.1.1
OPENCODE_DNS_SECONDARY=8.8.8.8
# Timeout (seconds) for a single MVP build request.
MVP_BUILD_TIMEOUT=600
# Local directory that mirrors the sidecar's shared /workspace volume.
MVP_BUILD_DIR=.data/mvp_builds
# Finished artifacts live separately from the mutable build workspace. In
# Compose this is mounted for the API and worker; production uses cloud storage.
ARTIFACT_DIR=.data/artifacts
# Credits deducted per MVP build.
MVP_BUILD_CREDIT_COST=30
# Timeout (seconds) for npm install during verification checkpoint.
MVP_VERIFY_INSTALL_TIMEOUT=180
# Timeout (seconds) for npm run build during verification checkpoint.
MVP_VERIFY_BUILD_TIMEOUT=120
# Skip npm install and npm run build during verification in 512MB RAM environments:
MVP_VERIFY_NPM=true
# A build is not marked complete until generated acceptance tests, required
# screens, and the frontend production build all pass.
MVP_RUN_ACCEPTANCE_TESTS=true
MVP_STRICT_TESTS=true
MVP_STRICT_SCREENS=true
MVP_QUALITY_GATE=true

# ── Object Storage (Neon S3-compatible, recommended) ─────────────
# Production must use a durable remote backend. Neon Object Storage requires a
# bucket name in addition to the endpoint and key pair generated in Neon.
# STORAGE_BACKEND=neon_s3
# S3_ENDPOINT_URL=https://<branch>.storage.<region>.aws.neon.tech
# S3_BUCKET=ai-solution-builder-artifacts
# S3_REGION=ap-southeast-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
#
# Cloudinary remains supported only for existing deployments.
# STORAGE_BACKEND=local
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ── Threat Scanning (SEC-SCAN-001) ───────────────
# Master switch for multi-layer threat scanning (Layer 0 offline rules always protect production)
SECURITY_SCAN_ENABLED=true
# Threshold for blocking requests: "suspicious" (strict, recommended) or "malicious"
SECURITY_SCAN_BLOCK_THRESHOLD=suspicious
# Behavior if scanners are down: "allow" (fail-open) | "quarantine" (403) | "block" (503)
SECURITY_SCAN_FAIL_UNAVAILABLE_MODE=allow
# Glob patterns to restrict scanning, or empty string to scan all incoming sources
SECURITY_SCAN_SOURCES=
# Verdict cache duration in seconds (default: 7 days)
SECURITY_CACHE_TTL=604800

# ── Layer 1: ClamAV Daemon (Optional) ────────────
# Docker container service (clamav/clamav:1.4)
CLAMAV_ENABLED=false
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=5.0

# ── Layer 2: VirusTotal API (Opt-in) ─────────────
# IMPORTANT: The free Community API is limited to 4 req/min and 500 req/day and
# MUST NOT be used in commercial products or services per VirusTotal Terms of Service.
# To enable this layer, you MUST set VIRUSTOTAL_ACK_TOS=true to acknowledge terms.
VIRUSTOTAL_ENABLED=false
VIRUSTOTAL_ACK_TOS=false
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_TIMEOUT=15.0
VIRUSTOTAL_MIN_DETECTIONS=3
VIRUSTOTAL_RPM=4
VIRUSTOTAL_DAILY=500

# ── Archive & Egress Safety Caps ─────────────────
ARCHIVE_MAX_ENTRIES=10000
ARCHIVE_MAX_UNCOMPRESSED_BYTES=524288000
ARCHIVE_MAX_RATIO=100
ARCHIVE_MAX_NESTED_DEPTH=2
SCAN_URL_INGEST=true
SCAN_GENERATED_ARTIFACTS=false

# ── Worker & Queue Architecture ──────────────────
# `worker` runs generation through the worker service/container, so API
# restarts cannot interrupt an active build. `inline` is a development fallback.
WORKER_MODE=worker
# Interval in seconds between worker queue polling cycles.
WORKER_POLL_INTERVAL=2.0
# Retries transient provider/network/DNS failures before a terminal refund.
WORKER_MAX_ATTEMPTS=3

# ── Frontend & Redirects ──────────────────────────
# Base URL of the frontend application for OAuth redirects and CORS validation.
FRONTEND_URL=http://localhost:3000

# ── OAuth Social Login ───────────────────────────
# Omit or leave empty to disable that social login provider.
# Buttons are dynamically shown on the login/register page only when BOTH ID and secret are set.
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=

# ── Anonymous Demo Identity ──────────────────────
# Anonymous authentication is not supported; use Auth0 for user identity.

# ── One-Click Deploy (GitHub, Render & Vercel) ──
# Server-level fallback credentials if user does not supply their own tokens in user settings.
GITHUB_TOKEN=
RENDER_API_KEY=
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# ── Payment Gateways (Monetization) ──────────────
# Razorpay credentials for India / UPI / Cards:
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Stripe credentials for Global Credit Cards:
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
# HMAC-SHA256 secret authenticating /api/v1/billing/webhook payloads.
# Fails closed (503) when unset. Generate e.g. `openssl rand -hex 32`.
PAYMENT_WEBHOOK_SECRET=

# ── Mobile Shell (Capacitor) ──────────────────────
# Required in production: the live origin the mobile WebView shell points to.
# CAP_SERVER_URL=https://your-domain.com

# ── Low Memory Tuning (512MB Free Tier Containers) ─
# Glibc memory arena cap (prevents RSS heap bloat in multi-threaded Python):
MALLOC_ARENA_MAX=2
# Node.js heap limit for Next.js & OpenCode (triggers early GC, keeps RSS under 110MB):
NODE_OPTIONS=--max-old-space-size=110
# PostgreSQL connection pool limits:
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_RECYCLE=300
# Toggle OpenCode sidecar if you want minimum possible RAM footprint (<180MB total):
ENABLE_OPENCODE_SIDECAR=true
